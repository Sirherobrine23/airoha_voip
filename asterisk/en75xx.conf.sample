;
; chan_en75xx -- FXS lines on EcoNet/Airoha EN75xx
;
; One [lineN] section per /dev/en75xx-fxsN. N is the line number the
; dialplan uses: Dial(EN75XX/0).
;

[general]
; nothing here yet; kept so the file layout matches the other channel
; drivers and so options can be added without breaking configs.

[line0]
; device      = /dev/en75xx-fxs0   ; default is /dev/en75xx-fxs<N>
; context     = default            ; where off-hook digits are matched
; callerid    = "Phone 1" <1001>
; language    = pt_BR              ; otherwise use Asterisk's default

; immediate=yes skips dial tone and digit collection entirely and jumps
; straight to extension "s" in the context. Useful for a hot line.
immediate     = no
; extension   = s                  ; only used when immediate=yes

; hardware_dtmf=yes disables the software DTMF detector. Leave it off:
; neither the Le9642 nor the ProSLIC parts report digits out of band on
; this platform, so the tones have to be pulled out of the audio.
hardware_dtmf = no

; Dial tone comes from the channel's indications.conf zone. A continuous
; one- or two-frequency tone uses the SLIC oscillator when supported;
; cadenced or modulated tones use Asterisk's software generator.
; hardware_tones   = no            ; force software even if supported
; dialtone_freq1   = 400           ; optional hardware frequency override
; dialtone_freq2   = 0             ; optional second oscillator
; dialtone_level   = -18           ; hardware output, dBm per oscillator
; play_dialtone    = yes           ; no leaves the line silent off-hook
; dialtone_volume  = 0             ; 0 uses Asterisk's default volume
; callprogress_volume = 0          ; 0 uses Asterisk's default volume

; mohinterpret = default

;[line1]
;context      = default
;callerid     = "Phone 2" <1002>
;language     = pt_BR
