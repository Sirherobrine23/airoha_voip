#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

led="$1"
[ -d "$led" ] && [ -w "$led/brightness" ] && [ -w "$led/trigger" ] || exit 1
max_brightness=$(cat "$led/max_brightness")

state=

sip_ready() {
	local registrations contacts mode

	mode=$(uci -q get asterisk.general.fxs_led_registration)
	if [ "$mode" != contacts ]; then
		registrations=$(/usr/sbin/asterisk -rx 'pjsip show registrations' 2>/dev/null) || return 1
		if printf '%s\n' "$registrations" | grep -Eq '[[:space:]]Registered([[:space:]]|$)'; then
			return 0
		fi
		[ "$mode" = outbound ] && return 1
		case "$registrations" in
			*'No objects found'*|*"No such command 'pjsip show registrations'"*) ;;
			*) return 1 ;;
		esac
	fi

	contacts=$(/usr/sbin/asterisk -rx 'pjsip show contacts' 2>/dev/null) || return 1
	printf '%s\n' "$contacts" |
		grep -Eq '^[[:space:]]*Contact:.*[[:space:]](Avail|NonQual)[[:space:]]'
}

set_led() {
	[ "$state" = "$1" ] && return

	case "$1" in
		off)
			echo none > "$led/trigger"
			echo 0 > "$led/brightness"
			;;
		on)
			echo none > "$led/trigger"
			echo "$max_brightness" > "$led/brightness"
			;;
		blink)
			echo timer > "$led/trigger"
			echo 500 > "$led/delay_on"
			echo 500 > "$led/delay_off"
			;;
	esac

	state="$1"
}

trap 'exit 0' INT TERM
trap 'set_led off' EXIT

set_led off

while :; do
	case "$(uci -q get asterisk.general.enabled)" in
		0|false|no) enabled=0 ;;
		*) enabled=1 ;;
	esac
	if [ "$enabled" = 0 ]; then
		set_led off
	elif sip_ready; then
		lines=$(/usr/sbin/asterisk -rx 'en75xx show lines' 2>/dev/null)
		line_state=$(printf '%s\n' "$lines" | awk '
			$2 ~ /^\/dev\/en75xx-fxs[0-9]+$/ {
				found = 1
				if ($5 == "dialing" || $5 == "ringing" || $5 == "up")
					active = 1
			}
			END {
				if (active) print "blink"
				else if (found) print "on"
				else print "off"
			}')
		set_led "$line_state"
	else
		set_led off
	fi
	sleep 2
done
