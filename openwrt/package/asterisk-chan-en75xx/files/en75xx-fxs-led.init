#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=97
USE_PROCD=1

start_service() {
	local led

	for led in /sys/class/leds/*:voip-*; do
		[ -d "$led" ] || continue
		procd_open_instance
		procd_set_param command /usr/sbin/en75xx-fxs-led "$led"
		procd_set_param respawn
		procd_close_instance
		break
	done
}
