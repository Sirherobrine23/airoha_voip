#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=97
USE_PROCD=1

start_service() {
	local led configured

	configured=$(uci -q get asterisk.general.fxs_led)
	if [ -n "$configured" ]; then
		case "$configured" in
			/sys/class/leds/*) led="$configured" ;;
			*) led="/sys/class/leds/$configured" ;;
		esac
		[ -d "$led" ] || return 0
		procd_open_instance "${led##*/}"
		procd_set_param command /usr/sbin/en75xx-fxs-led "$led"
		procd_set_param respawn
		procd_close_instance
		return 0
	fi

	for led in /sys/class/leds/*:voip /sys/class/leds/*:voip-*; do
		[ -d "$led" ] || continue
		procd_open_instance "${led##*/}"
		procd_set_param command /usr/sbin/en75xx-fxs-led "$led"
		procd_set_param respawn
		procd_close_instance
	done
}
