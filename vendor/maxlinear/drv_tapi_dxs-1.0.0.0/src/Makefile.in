nodist_EXTRA_drv_tapi_dxs_ko_SOURCES = 
nodist_drv_tapi_dxs_ko_SOURCES = \
   ../include/drv_config_defines.h

INCLUDES_NO_KERNEL = -I@abs_top_builddir@/include \
	-I@abs_top_srcdir@/include -I@abs_top_srcdir@/src/dxs \
	-I@abs_top_srcdir@/src/tapi $(am__append_6) $(am__append_7)
AM_CPPFLAGS = $(INCLUDES_NO_KERNEL) $(am__append_8) $(am__append_9)

# Additional flags for DUSLIC driver compiled as library
libdrvdxs_additional_cflags = \
   -DLINUX \
   -DRW_MULTI_THREAD \
   -D_REENTRANT \
   -D_THREAD_SAFE \
   -D_POSIX_SOURCE -D_GNU_SOURCE \
   -DIFXOS_USE_DEV_IO=1


# Use old standard to keep compatibility with "unknown" old toolchains.
# gnu is used to compile linux code parts without warnings.
@WARNINGS_FALSE@AM_CFLAGS = -Wall -std=gnu90 $(am__append_10)

# Use old standard to keep compatibility with "unknown" old toolchains.
# gnu is used to compile linux code parts without warnings.
@WARNINGS_TRUE@AM_CFLAGS = -Wall -Wimplicit -Wreturn-type -Wunused \
@WARNINGS_TRUE@	-Wswitch -Wcomment -Wparentheses \
@WARNINGS_TRUE@	-Wmissing-prototypes -std=gnu90 \
@WARNINGS_TRUE@	$(am__append_10)
@WITH_KERNEL_MODULE_TRUE@drv_tapi_dxs_CFLAGS = -D__LINUX__ -DLINUX -D__KERNEL__ \
@WITH_KERNEL_MODULE_TRUE@                      -DMODULE -DEXPORT_SYMTAB $(AM_CFLAGS) \
@WITH_KERNEL_MODULE_TRUE@                      -DTAPI_HAVE_TIMERS \
@WITH_KERNEL_MODULE_TRUE@                      -fno-common -fno-strict-overflow -fno-delete-null-pointer-checks -fwrapv

@WITH_KERNEL_MODULE_TRUE@drv_tapi_dxs_ko_LDFLAGS = -r -nostdlib
@WITH_KERNEL_MODULE_TRUE@drv_tapi_dxs_OBJS = "$(subst .c,.o, $(drv_tapi_dxs_SOURCES))"

# library flags
@WITH_KERNEL_MODULE_FALSE@libdrvdxstapi_a_CFLAGS = \
@WITH_KERNEL_MODULE_FALSE@	$(libdrvdxstapi_additional_cflags) \
@WITH_KERNEL_MODULE_FALSE@	$(AM_CFLAGS)

all: all-am

.SUFFIXES:
.SUFFIXES: .c .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu src/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu src/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-libLIBRARIES: $(lib_LIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(INSTALL_DATA) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(INSTALL_DATA) $$list2 "$(DESTDIR)$(libdir)" || exit $$?; }
	@$(POST_INSTALL)
	@list='$(lib_LIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  if test -f $$p; then \
	    $(am__strip_dir) \
	    echo " ( cd '$(DESTDIR)$(libdir)' && $(RANLIB) $$f )"; \
	    ( cd "$(DESTDIR)$(libdir)" && $(RANLIB) $$f ) || exit $$?; \
	  else :; fi; \
	done

uninstall-libLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LIBRARIES)'; test -n "$(libdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(libdir)'; $(am__uninstall_files_from_dir)

clean-libLIBRARIES:
	-test -z "$(lib_LIBRARIES)" || rm -f $(lib_LIBRARIES)
dxs/$(am__dirstamp):
