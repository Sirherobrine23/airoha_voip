	dxs/drv_dxs_mbx.c dxs/drv_dxs_outbox.c dxs/drv_dxs_fifo.c \
	dxs/drv_dxs_init.c dxs/drv_dxs_irq.c dxs/drv_dxs_bbd.c \
	dxs/drv_dxs_alm.c dxs/drv_dxs_alm_lt.c dxs/drv_dxs_ioctl.c \
	dxs/drv_dxs_dwld.c dxs/drv_dxs_cid.c dxs/drv_dxs_cid_sm.c \
	dxs/drv_dxs_pcm.c dxs/drv_dxs_tg.c dxs/drv_dxs_dtmf.c \
	dxs/drv_dxs_dtmf_sm.c dxs/drv_dxs_event.c dxs/drv_dxs_debug.c \
	tapi/drv_tapi_dial.c tapi/drv_tapi_event.c \
	tapi/drv_tapi_debug.c tapi/drv_tapi_debug_buffer.c \
	tapi/drv_tapi_ioctl.c tapi/drv_tapi_meter.c \
