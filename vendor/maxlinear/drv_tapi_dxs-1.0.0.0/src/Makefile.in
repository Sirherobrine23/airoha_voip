.MAKE: install-am install-exec-am install-strip

.PHONY: CTAGS GTAGS TAGS all all-am check check-am clean \
	clean-binPROGRAMS clean-generic clean-libLIBRARIES \
	cscopelist-am ctags ctags-am distclean distclean-compile \
	distclean-generic distclean-tags distdir dvi dvi-am html \
	html-am info info-am install install-am install-binPROGRAMS \
	install-data install-data-am install-dvi install-dvi-am \
	install-exec install-exec-am install-exec-hook install-html \
	install-html-am install-info install-info-am \
	install-libLIBRARIES install-man install-pdf install-pdf-am \
	install-ps install-ps-am install-strip installcheck \
	installcheck-am installdirs maintainer-clean \
	maintainer-clean-generic mostlyclean mostlyclean-compile \
	mostlyclean-generic pdf pdf-am ps ps-am tags tags-am uninstall \
	uninstall-am uninstall-binPROGRAMS uninstall-libLIBRARIES

.PRECIOUS: Makefile


.PHONY: lint
lint:
# Notes:
#  * do not put path to linux header includes as it breaks checking the driver code.
#  * you can add -v flag to get more detailed info about error
#  * cppcheck_out directory is used to store results and as lint build dir to speed up
#    consecutive checks
#  * -j1 is used to get information about unused functions / variables
#  * even deeper analysis --max-ctu-depth=10 --check-level=exhaustive --force
	@mkdir -p @abs_top_srcdir@/cppcheck_out
	@cppcheck \
		--enable=all \
		--language=c --std=c99 --platform=unix64 \
		--max-configs=12 -j1 --force\
		-DLINUX -D__LINUX__ -DHAVE_CONFIG_H -D__LITTLE_ENDIAN \
		-D__KERNEL__ -DMODULE -DEXPORT_SYMTAB -DTAPI_HAVE_TIMERS -DTAPI_HL_DRIVER \
		-UIFXOS_ENABLED -UVXWORKS -UWIN32 -UDRV_TAPI_NAME \
		--suppressions-list=@abs_top_srcdir@/dev/cppcheck_suppressions_list.txt \
		--inconclusive \
		--cppcheck-build-dir=@abs_top_srcdir@/cppcheck_out/ \
		--checkers-report=@abs_top_srcdir@/cppcheck_out/cppcheck_checkers_report.txt \
		--output-file=@abs_top_srcdir@/cppcheck_out/cppcheck_results.txt \
		-I@abs_top_srcdir@/include \
		@abs_top_srcdir@/src/

install-exec-hook: $(bin_PROGRAMS)
	@for p in $(bin_PROGRAMS); do \
		$(STRIP) --strip-debug $(DESTDIR)$(bindir)/$$p; \
		echo "  Stripping symbols: $(STRIP) --strip-debug $(DESTDIR)$(bindir)/$$p"; \
	done

@WITH_KERNEL_MODULE_TRUE@drv_tapi_dxs.ko: $(drv_tapi_dxs_SOURCES) $(nodist_drv_tapi_dxs_ko_SOURCES) $(nodist_EXTRA_drv_tapi_dxs_SOURCES) $(EXTRA_DIST)
@WITH_KERNEL_MODULE_TRUE@	@echo -e "Making Linux kernel object"
@WITH_KERNEL_MODULE_TRUE@	@for f in $(drv_tapi_dxs_SOURCES) ; do \
@WITH_KERNEL_MODULE_TRUE@		if test ! -e $(PWD)/$$f; then \
@WITH_KERNEL_MODULE_TRUE@			echo "LN $$f"; \
@WITH_KERNEL_MODULE_TRUE@			mkdir -p $(PWD)/`dirname $$f`/; \
@WITH_KERNEL_MODULE_TRUE@			ln -s @abs_srcdir@/$$f $(PWD)/$$f; \
@WITH_KERNEL_MODULE_TRUE@		fi; \
@WITH_KERNEL_MODULE_TRUE@	done;

@WITH_KERNEL_MODULE_TRUE@	@echo -e "# drv_tapi_dxs: Generated to build Linux kernel object" > $(PWD)/Kbuild
@WITH_KERNEL_MODULE_TRUE@	@echo -e "obj-m := $(subst .ko,.o,$@)" >> $(PWD)/Kbuild
@WITH_KERNEL_MODULE_TRUE@	@echo -e "$(subst .ko,,$@)-y := $(drv_tapi_dxs_OBJS)" >> $(PWD)/Kbuild
@WITH_KERNEL_MODULE_TRUE@	@echo -e "EXTRA_CFLAGS := -DHAVE_CONFIG_H  $(drv_tapi_dxs_CFLAGS) $(AM_CPPFLAGS)" >> $(PWD)/Kbuild

#	Kernel Makefile exports LDFLAGS, which might pull-in wrong settings
@WITH_KERNEL_MODULE_TRUE@	LDFLAGS= \
@WITH_KERNEL_MODULE_TRUE@	$(MAKE) ARCH=@KERNEL_ARCH@ -C @KERNEL_BUILD_PATH@ O=@KERNEL_BUILD_PATH@ \
@WITH_KERNEL_MODULE_TRUE@           M=$(PWD) KBUILD_EXTRA_SYMBOLS="$(strip @KBUILD_EXTRA_SYMBOLS@)" \
@WITH_KERNEL_MODULE_TRUE@           CROSS_COMPILE=@CROSS_COMPILE@ modules

@WITH_KERNEL_MODULE_TRUE@clean-generic:
@WITH_KERNEL_MODULE_TRUE@	@echo "drv_tapi_dxs: Cleanup Linux kernel object build"
@WITH_KERNEL_MODULE_TRUE@	@- find . -name ".*.cmd" | xargs rm -f
@WITH_KERNEL_MODULE_TRUE@	@- find . -name "*.o" | xargs rm -f
@WITH_KERNEL_MODULE_TRUE@	@- find . -name "*.mod.c" | xargs rm -f
@WITH_KERNEL_MODULE_TRUE@	@- find . -name "*.mod" | xargs rm -f
@WITH_KERNEL_MODULE_TRUE@	@- rm -f Module.symvers Module.symvers.temp Kbuild modules.order
@WITH_KERNEL_MODULE_TRUE@	@- rm -rf .tmp_versions

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
